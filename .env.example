# Copy this file to .env and fill in real values. Never commit .env.

# Reddit mention data comes via ApeWisdom's free public API (apewisdom.io) -- no credentials
# needed, so there's nothing to configure here for it.

# --- Finnhub (https://finnhub.io/register -> free tier API key) ---
FINNHUB_API_KEY=

# --- SMTP (for email alerts). Gmail example: use an App Password, not your login password ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
