# Copy this file to .env and fill in real values. Never commit .env.

# --- Reddit (https://www.reddit.com/prefs/apps -> "create app" -> type "script") ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hypetrain-scanner/0.1 by <your_reddit_username>

# --- Finnhub (https://finnhub.io/register -> free tier API key) ---
FINNHUB_API_KEY=

# --- SMTP (for email alerts). Gmail example: use an App Password, not your login password ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
